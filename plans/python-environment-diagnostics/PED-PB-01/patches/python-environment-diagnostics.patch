+def test_python_env_preserves_the_active_interpreter_symlink(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path: Path,
+) -> None:
+    """Report the active venv entrypoint rather than its base-runtime target."""
+    target = tmp_path / "base/python"
+    target.parent.mkdir()
+    target.touch()
+    executable = tmp_path / "venv/bin/python"
+    executable.parent.mkdir(parents=True)
+    executable.symlink_to(target)
+    monkeypatch.setattr(runtime.sys, "executable", str(executable))
+    monkeypatch.setattr(
+        runtime.importlib.metadata,
+        "distributions",
+        lambda: (_Distribution("example", "1.0", tmp_path / "site-packages"),),
+    )
+
+    diagnosis = runtime.diagnose_python_env()
+
+    assert diagnosis.interpreter == executable
