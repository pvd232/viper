+def test_python_env_rejects_an_empty_distribution_set(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """Report the existing no-distributions rule through the shared diagnosis."""
+    monkeypatch.setattr(runtime.importlib.metadata, "distributions", lambda: ())
+
+    diagnosis = runtime.diagnose_python_env()
+
+    assert diagnosis.healthy is False
+    assert diagnosis.violations == ("no_distributions",)
+    with pytest.raises(runtime.PythonEnvironmentError) as caught:
+        runtime.observe_python_env()
+    assert caught.value.diagnosis == diagnosis
