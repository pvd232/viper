@@ -0,0 +1,425 @@
+"""Check file selection and prediction evidence for additional model publications."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import pytest
+from viper._cloud import HuggingFaceRepository, RevisionManifest, manifest_revision
+from viper.execution._promotion import PromotionInventory
+from viper.execution._promotion_journal import SnapshotCopy
+from viper.execution._promotion_worker import CopyRequest
+from viper.references import (
+    GcsFileRef,
+    GcsStageResultSnapshotRef,
+    HuggingFaceFileRef,
+    HuggingFaceStageResultSnapshotRef,
+    ResolvedFileRef,
+    ResolvedRunRef,
+    SnapshotFileRef,
+)
+from viper.serialization import document_digest
+from viper.storage import RunPromotionPolicy, TransferLimits, ViperCloudDestination
+
+from tools.graph_publication import recover as recovery
+from tools.graph_publication.checks import (
+    SELECTED_MODELS,
+    model_checks,
+    register,
+    saved_environment,
+)
+from tools.graph_publication.prepare import capture_sources, original_bytes
+
+
+@pytest.mark.parametrize(
+    "model", ("mil_string112_certification_20261006", "hopfield_certification_20261007")
+)
+def test_frozen_runtime_formats_require_the_recorded_l4_versions(model: str) -> None:
+    """Read the committed MIL and Hopfield records into the same exact requirements."""
+    root = Path(__file__).resolve().parents[1]
+    runtime = json.loads((root / "experiments" / model / "runtime.json").read_bytes())
+    assert saved_environment(runtime) == {
+        "python": "3.13.15",
+        "torch": "2.14.0+cu130",
+        "numpy": "2.5.3",
+        "cuda": "13.0",
+        "device": "NVIDIA L4",
+    }
+
+
+@pytest.mark.parametrize(
+    "change",
+    (
+        "aliases",
+        "bytes",
+        "sha256",
+        "commit",
+        "repository",
+        "missing_address",
+        "settings",
+        "roles",
+    ),
+)
+def test_model_checks_preserve_valid_saved_addresses(
+    tmp_path: Path, change: str
+) -> None:
+    """Keep request and prediction bytes after journal growth; reject changed inputs."""
+    root = Path(__file__).resolve().parents[1]
+    record = json.loads((root / "models/direct_mil.json").read_bytes())
+    inputs = json.loads((root / record["model_inputs"]).read_bytes())["files"]
+    payloads = [record["selected_checkpoint"], record["tune_predictions"]]
+    payloads.extend(inputs[key] for key in ("response_data", "manifest"))
+    members = tuple(
+        sorted(
+            (
+                SnapshotFileRef(
+                    path=item["sha256"], sha256=item["sha256"], bytes=item["bytes"]
+                )
+                for item in payloads
+            ),
+            key=lambda item: item.path,
+        )
+    )
+    copy = SnapshotCopy(
+        source=GcsStageResultSnapshotRef(
+            bucket="original", owner="owner", workspace="models", revision="a" * 64
+        ),
+        source_files=members,
+        expected=RevisionManifest(
+            owner="owner",
+            workspace="models",
+            revision=manifest_revision(members),
+            files=members,
+        ),
+        dependencies_sha256="b" * 64,
+        previous_head=None,
+        published=HuggingFaceStageResultSnapshotRef(
+            repository="owner/models", repo_type="dataset", commit="b" * 40
+        ),
+    )
+    progress = tmp_path / "progress.json"
+    result = tmp_path / "result.json"
+    saved = {"copies": {"later": copy.model_dump(mode="json")}}
+    publication: dict[str, Any] = {
+        "passed": True,
+        "host": HuggingFaceRepository(
+            repository="owner/models", repo_type="dataset"
+        ).model_dump(mode="json"),
+        "source_roots": [record["native_benchmark"]["cloud_run"]],
+    }
+
+    def save_progress() -> None:
+        """Bind the comparison receipt to this complete set of copied snapshots."""
+        progress.write_text(json.dumps(saved))
+        publication["mapping_sha256"] = hashlib.sha256(
+            json.dumps(
+                saved, ensure_ascii=False, separators=(",", ":"), sort_keys=True
+            ).encode()
+        ).hexdigest()
+        result.write_text(json.dumps({"publications": [publication]}))
+
+    save_progress()
+    output = tmp_path / "checks"
+    (request,) = model_checks(root, progress, result, output)
+    settings = json.loads(request.read_bytes())
+    settings["files"] = dict(reversed(settings["files"].items()))
+    if change in ("bytes", "sha256"):
+        settings["checkpoint"][change] = settings["expected"][change]
+    elif change == "commit":
+        settings["expected"]["stored_at"]["commit"] = "c" * 40
+    elif change == "repository":
+        settings["files"]["manifest"]["stored_at"]["repository"] = "owner/other"
+    elif change == "settings":
+        settings["environment"]["torch"] = "changed"
+    elif change == "roles":
+        settings["files"]["extra"] = settings["checkpoint"]
+    request.write_text(json.dumps(settings, indent=1) + "\n")
+    prediction = output / "mil-123464" / "prediction.npz"
+    prediction.parent.mkdir()
+    saved_array(prediction, 2.0)
+    before = {
+        path: (path.read_bytes(), path.stat().st_mtime_ns)
+        for path in (request, prediction)
+    }
+
+    earlier = copy.model_dump(mode="json")
+    earlier["published"]["commit"] = "a" * 40
+    saved["copies"] = {"earlier": earlier, **saved["copies"]}
+    if change == "missing_address":
+        del saved["copies"]["later"]
+    save_progress()
+    if change == "aliases":
+        assert model_checks(root, progress, result, output) == [request]
+        (fresh,) = model_checks(root, progress, result, tmp_path / "fresh")
+        assert (
+            json.loads(fresh.read_bytes())["checkpoint"]["stored_at"]["commit"]
+            == "a" * 40
+        )
+    else:
+        with pytest.raises(ValueError, match="Recovery"):
+            model_checks(root, progress, result, output)
+    assert before == {
+        path: (path.read_bytes(), path.stat().st_mtime_ns) for path in before
+    }
+
+
+def saved_array(path: Path, value: float) -> ResolvedFileRef:
+    """Write one numerical prediction with named rows and columns."""
+    np.savez(
+        path,
+        prediction=np.asarray([[value]]),
+        perts=np.asarray(["p"]),
+        genes=np.asarray(["g"]),
+    )
+    raw = path.read_bytes()
+    return ResolvedFileRef(
+        bytes=len(raw),
+        sha256=hashlib.sha256(raw).hexdigest(),
+        stored_at=HuggingFaceFileRef(
+            repository="owner/models",
+            repo_type="dataset",
+            commit="a" * 40,
+            path=path.name,
+        ),
+    )
+
+
+@pytest.mark.parametrize("kind", ("gcs", "another_repository"))
+def test_recovery_rejects_original_storage(tmp_path: Path, kind: str) -> None:
+    """Reject an original address before any cached or remote read."""
+    reader = recovery.DestinationReader(
+        tmp_path, HuggingFaceRepository(repository="owner/models", repo_type="dataset")
+    )
+    location = (
+        GcsFileRef(
+            bucket="original",
+            owner="owner",
+            workspace="models",
+            revision="a" * 64,
+            path="weights.pt",
+        )
+        if kind == "gcs"
+        else HuggingFaceFileRef(
+            repository="owner/other",
+            repo_type="dataset",
+            commit="a" * 40,
+            path="weights.pt",
+        )
+    )
+    reference = ResolvedFileRef(stored_at=location, bytes=1, sha256="b" * 64)
+    for read in (reader.read, reader.path):
+        with pytest.raises(ValueError, match="original storage is blocked"):
+            read(reference)
+    assert not tuple(tmp_path.rglob("weights.pt"))
+
+
+def test_recovery_keeps_prediction_during_report_repair(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Reuse a saved prediction when its expected-result report is corrected."""
+    expected = saved_array(tmp_path / "expected.npz", 3.0)
+    weights = tmp_path / "weights.pt"
+    weights.write_bytes(b"weights")
+    checkpoint = ResolvedFileRef(
+        stored_at=expected.stored_at.model_copy(update={"path": "weights.pt"}),
+        sha256=hashlib.sha256(weights.read_bytes()).hexdigest(),
+        bytes=7,
+    )
+    files = {"expected.npz": tmp_path / "expected.npz", "weights.pt": weights}
+    current = {
+        "python": "test",
+        "torch": "test",
+        "numpy": "test",
+        "cuda": "test",
+        "device": "test",
+    }
+    settings: dict[str, Any] = {
+        "model": "mil",
+        "seed": 123464,
+        "host": {
+            "provider": "huggingface",
+            "repository": "owner/models",
+            "repo_type": "dataset",
+        },
+        "checkpoint": checkpoint.model_dump(mode="json"),
+        "files": {},
+        "expected": expected.model_dump(mode="json"),
+        "environment": current,
+        "split": "tune",
+        "atol": 0.0,
+        "rtol": 0.0,
+    }
+    request = tmp_path / "request.json"
+    request.write_text(json.dumps(settings))
+    calls = []
+
+    def path(reader: recovery.DestinationReader, reference: ResolvedFileRef) -> Path:
+        """Serve the controlled file after checking its destination address."""
+        reader.require_destination(reference.stored_at)
+        return files[reference.stored_at.path]
+
+    def predict(index: Path, output: Path, split: str) -> Path:
+        """Record one forward pass using the selected checkpoint."""
+        assert json.loads(index.read_bytes())["checkpoint_sha256"] == checkpoint.sha256
+        assert split == "tune"
+        calls.append(output)
+        saved_array(output, 2.0)
+        return output
+
+    monkeypatch.setattr(recovery.DestinationReader, "path", path)
+    monkeypatch.setattr(recovery, "environment", lambda: current)
+    monkeypatch.setattr(recovery, "predict", predict)
+    workspace = tmp_path / "fresh"
+    with pytest.raises(AssertionError):
+        recovery.recover(request, workspace)
+    before = (workspace / "prediction.npz").read_bytes()
+    fixed = saved_array(tmp_path / "expected.npz", 2.0)
+    settings["expected"] = fixed.model_dump(mode="json")
+    request.write_text(json.dumps(settings))
+    result = recovery.recover(request, workspace)
+    assert result["passed"] and result["maximum_absolute_error"] == 0
+    assert len(calls) == 1
+    assert (workspace / "prediction.npz").read_bytes() == before
+    settings["checkpoint"]["sha256"] = "d" * 64
+    request.write_text(json.dumps(settings))
+    with pytest.raises(ValueError, match="recovery request changed"):
+        recovery.recover(request, workspace)
+    settings["environment"]["torch"] = "another-version"
+    monkeypatch.setattr(recovery, "environment", lambda: {**current, "torch": "test"})
+    request.write_text(json.dumps(settings))
+    with pytest.raises(ValueError, match="environment differs"):
+        recovery.recover(request, tmp_path / "another-fresh")
+
+
+def test_capture_preserves_bytes_and_original_locations(tmp_path: Path) -> None:
+    """Check local source bytes and retain their original location record."""
+    path = tmp_path / "prior.bin"
+    path.write_bytes(b"prior")
+    payload = {
+        "bytes": 5,
+        "sha256": hashlib.sha256(b"prior").hexdigest(),
+        "sources": [{"kind": "vm_file", "path": str(path)}],
+    }
+    captured, size = capture_sources(tmp_path, tmp_path, b"inventory", [payload])
+    assert size == 14
+    assert any(item.sha256 == payload["sha256"] for item in captured)
+    assert any(
+        item.stored_at.path == "source-records/original-locations.json"
+        for item in captured
+    )
+    path.write_bytes(b"other")
+    with pytest.raises(ValueError, match="Original file is unavailable"):
+        original_bytes(payload, tmp_path)
+    assert path.read_bytes() == b"other"
+
+
+@pytest.mark.parametrize(
+    "failure", ("none", "missing_report", "wrong_model", "changed_pointer")
+)
+@pytest.mark.parametrize("separate_model_root", (False, True))
+def test_registration_requires_all_selected_models(
+    tmp_path: Path, failure: str, separate_model_root: bool
+) -> None:
+    """Write the final reference set only after all four recovery records match."""
+    host = HuggingFaceRepository(repository="owner/models", repo_type="dataset")
+    roots = tuple(
+        ResolvedRunRef(
+            stored_at=GcsFileRef(
+                bucket="original",
+                owner="owner",
+                workspace="models",
+                revision=str(index) * 64,
+                path=f"run-{index}.yaml",
+            ),
+            sha256=str(index) * 64,
+            bytes=1,
+        )
+        for index in range(1, 5)
+    )
+    request = CopyRequest(
+        repository_root=tmp_path,
+        inventory=PromotionInventory(roots=roots, required_files={}),
+        policy=RunPromotionPolicy(hosts=(host,)),
+        destination=ViperCloudDestination(owner="owner", workspace="models"),
+        limits=TransferLimits(staging_bytes=1024, cache_bytes=512, connections=1),
+    )
+    request_path = tmp_path / "copy.json"
+    request_path.write_text(request.model_dump_json())
+    result_path = tmp_path / "result.json"
+    result_path.write_text(
+        json.dumps(
+            {
+                "operation_sha256": document_digest(request),
+                "publications": [
+                    {
+                        "passed": True,
+                        "host": host.model_dump(mode="json"),
+                        "required_files_checked": 0,
+                        "source_roots": [ref.model_dump(mode="json") for ref in roots],
+                    }
+                ],
+            }
+        )
+    )
+    model_root = tmp_path / "frozen" if separate_model_root else tmp_path
+    models = model_root / "models"
+    models.mkdir(parents=True)
+    for name in ("direct_mil", "asymmetric_hopfield"):
+        (models / f"{name}.json").write_text("{}")
+    checks = tmp_path / "checks"
+    checks.mkdir()
+    for name, root in zip(SELECTED_MODELS, roots, strict=True):
+        model, seed = name.split("-")
+        directory = checks / name
+        directory.mkdir()
+        checkpoint = saved_array(directory / "prediction.npz", 2.0)
+        settings = {
+            "model": model,
+            "seed": int(seed),
+            "checkpoint": checkpoint.model_dump(mode="json"),
+            "source_run": root.model_dump(mode="json"),
+            "source_pointer_sha256": hashlib.sha256(b"{}").hexdigest(),
+            "expected": checkpoint.model_dump(mode="json"),
+            "environment": {},
+            "atol": 0.0,
+            "rtol": 0.0,
+        }
+        settings_path = checks / f"{name}.json"
+        settings_path.write_text(json.dumps(settings))
+        report = {
+            "passed": True,
+            "request_sha256": hashlib.sha256(settings_path.read_bytes()).hexdigest(),
+            "prediction_sha256": checkpoint.sha256,
+            "checkpoint_sha256": checkpoint.sha256,
+            "model": model,
+            "seed": int(seed),
+            "expected_sha256": checkpoint.sha256,
+            "environment": {},
+            "atol": 0.0,
+            "rtol": 0.0,
+        }
+        (directory / "verified.json").write_text(json.dumps(report))
+    last = checks / SELECTED_MODELS[-1] / "verified.json"
+    if failure == "missing_report":
+        last.unlink()
+    elif failure == "wrong_model":
+        report = json.loads(last.read_bytes())
+        report["seed"] = 123464
+        last.write_text(json.dumps(report))
+    elif failure == "changed_pointer":
+        (models / "direct_mil.json").write_text('{"changed": true}')
+    output = tmp_path / "accepted.json"
+    if failure == "none":
+        accepted = register(request_path, result_path, checks, output, model_root)
+        assert len(accepted["recovery"]) == 4
+        assert json.loads(output.read_bytes()) == accepted
+    else:
+        with pytest.raises((FileNotFoundError, ValueError)):
+            register(request_path, result_path, checks, output, model_root)
+        assert not output.exists()
+    if failure != "changed_pointer":
+        assert all(path.read_bytes() == b"{}" for path in models.iterdir())
