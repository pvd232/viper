+"""Publish the selected models using VIPER's checked copy operation."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+from huggingface_hub import HfApi
+from viper._cloud import HuggingFaceRepository
+from viper.execution import promote_run_to_cloud
+from viper.execution._promotion_worker import CopyRequest
+from viper.execution._publication import write_synchronized
+from viper.serialization import document_digest
+
+from rico.domain.mil.serialization import file_sha256
+
+
+def publish(
+    request_path: Path, output: Path, pilot: int | None = None
+) -> dict[str, Any]:
+    """Copy the graph and retain the worker's verified result."""
+    request = CopyRequest.model_validate_json(request_path.read_bytes())
+    if pilot is not None:
+        selected = request.inventory.roots[pilot]
+        inventory = request.inventory.model_copy(
+            update={"roots": (selected,), "supporting_roots": (), "required_files": {}}
+        )
+        request = request.model_copy(update={"inventory": inventory})
+    api = HfApi()
+    for host in request.policy.hosts:
+        if isinstance(host, HuggingFaceRepository):
+            api.auth_check(host.repository, repo_type=host.repo_type, write=True)
+    settings = request.repository_root / "viper.toml"
+    settings_hash = file_sha256(settings)
+    runs = promote_run_to_cloud(
+        request.repository_root,
+        request.inventory.roots,
+        request.destination,
+        policy=request.policy,
+        limits=request.limits,
+        required_files=request.inventory.required_files,
+        supporting_roots=request.inventory.supporting_roots,
+        trusted_source_repositories=request.trusted_source_repositories,
+    )
+    result_path = (
+        request.repository_root
+        / ".viper/promotion"
+        / document_digest(request)
+        / "result.json"
+    )
+    result: dict[str, Any] = json.loads(result_path.read_bytes())
+    actual = [run.model_dump(mode="json") for run in runs]
+    recorded = [
+        run for host in result["publications"] for run in host["destination_roots"]
+    ]
+    if actual != recorded or any(not host["passed"] for host in result["publications"]):
+        raise ValueError("The copy result differs from the returned model references")
+    if file_sha256(settings) != settings_hash:
+        raise ValueError("The source storage settings changed")
+    write_synchronized(
+        output, (json.dumps(result, indent=2, sort_keys=True) + "\n").encode()
+    )
+    return result
+
+
+def main() -> None:
+    """Read the frozen request and optionally select one model for the pilot."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("request", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--pilot", type=int)
+    args = parser.parse_args()
+    result = publish(args.request, args.output, args.pilot)
+    print(
+        json.dumps(
+            {"operation_sha256": result["operation_sha256"], "output": str(args.output)}
+        )
+    )
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/graph_publication/recover.py b/tools/graph_publication/recover.py
new file mode 100644
index 00000000..bbfa8715
--- /dev/null
+++ b/tools/graph_publication/recover.py
@@ -0,0 +1,164 @@
+"""Load copied model files from Hugging Face and check their predictions."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from viper._cloud import HuggingFaceRepository
+from viper._source import RunFetcher
+from viper.references import HuggingFaceFileRef, ResolvedFileRef, StorageModel
+from viper.storage import LocalArtifactStore
+
+from rico.commands.model_prediction import predict
+from rico.domain.mil.serialization import file_sha256
+
+
+class DestinationReader(RunFetcher):
+    """Read only files from the selected additional repository."""
+
+    def __init__(self, root: Path, host: HuggingFaceRepository) -> None:
+        """Start a reader in the recovery workspace."""
+        super().__init__(root, LocalArtifactStore(root), "")
+        self.host = host
+
+    def require_destination(self, location: StorageModel) -> None:
+        """Reject every original storage address before reading a file."""
+        if not isinstance(location, HuggingFaceFileRef) or (
+            location.repository != self.host.repository
+            or location.repo_type != self.host.repo_type
+        ):
+            raise ValueError("original storage is blocked")
+
+    def __call__(self, location: StorageModel) -> bytes:
+        """Check the host and use VIPER's ordinary file reader."""
+        self.require_destination(location)
+        return super().__call__(location)
+
+    def read(self, reference: ResolvedFileRef) -> bytes:
+        """Check the host before reading a document or a cached file."""
+        self.require_destination(reference.stored_at)
+        return super().read(reference)
+
+    def path(self, reference: ResolvedFileRef) -> Path:
+        """Check the host and download the exact recorded bytes."""
+        self.require_destination(reference.stored_at)
+        return super().path(reference)
+
+
+def compare(prediction: Path, expected: Path, atol: float, rtol: float) -> float:
+    """Check named axes and the predeclared numerical tolerance."""
+    with (
+        np.load(prediction, allow_pickle=False) as actual,
+        np.load(expected, allow_pickle=False) as saved,
+    ):
+        for axis in ("perts", "genes"):
+            expected_axis = axis if axis in saved.files else "response_gene_ids"
+            np.testing.assert_array_equal(
+                actual[axis].astype(str), saved[expected_axis].astype(str)
+            )
+        observed = actual["prediction"]
+        required = saved["prediction"]
+        if not np.isfinite(observed).all() or not np.isfinite(required).all():
+            raise ValueError("Predictions must contain finite numbers")
+        np.testing.assert_allclose(observed, required, atol=atol, rtol=rtol)
+        return float(np.max(np.abs(observed - required)))
+
+
+def environment() -> dict[str, Any]:
+    """Describe the Python and numerical libraries used for this prediction."""
+    return {
+        "python": sys.version.split()[0],
+        "torch": str(torch.__version__),
+        "numpy": np.__version__,
+        "cuda": torch.version.cuda,
+        "device": torch.cuda.get_device_name(),
+    }
+
+
+def recover(settings_path: Path, workspace: Path) -> dict[str, Any]:
+    """Save the predictions, then compare them with the expected values."""
+    settings: dict[str, Any] = json.loads(settings_path.read_bytes())
+    current_environment = environment()
+    if current_environment != settings["environment"]:
+        raise ValueError(
+            "The prediction environment differs from the saved model environment"
+        )
+    plan_hash = file_sha256(settings_path)
+    inputs = {
+        key: settings[key]
+        for key in ("model", "seed", "checkpoint", "files", "split", "environment")
+    }
+    input_hash = hashlib.sha256(json.dumps(inputs, sort_keys=True).encode()).hexdigest()
+    workspace.mkdir(parents=True, exist_ok=True)
+    binding = workspace / "request.sha256"
+    if binding.exists() and binding.read_text().strip() != input_hash:
+        raise ValueError("The recovery request changed")
+    output = workspace / "prediction.npz"
+    if not binding.exists():
+        if any(workspace.iterdir()):
+            raise ValueError("Recovery requires a fresh workspace")
+        binding.write_text(input_hash + "\n")
+        (workspace / "viper.toml").write_text("[workspace]\nschema_version = 2\n")
+    reader = DestinationReader(
+        workspace, HuggingFaceRepository.model_validate(settings["host"])
+    )
+    expected_ref = ResolvedFileRef.model_validate(settings["expected"])
+    expected = reader.path(expected_ref)
+    if not output.exists():
+        checkpoint = ResolvedFileRef.model_validate(settings["checkpoint"])
+        files = {
+            name: str(reader.path(ResolvedFileRef.model_validate(reference)))
+            for name, reference in settings["files"].items()
+        }
+        index = {
+            "model": settings["model"],
+            "checkpoint": str(reader.path(checkpoint)),
+            "checkpoint_sha256": checkpoint.sha256,
+            "files": files,
+        }
+        index_path = workspace / "inputs.json"
+        index_path.write_text(json.dumps(index, indent=2) + "\n")
+        predict(index_path, output, settings["split"])
+    difference = compare(output, expected, settings["atol"], settings["rtol"])
+    result = {
+        "passed": True,
+        "model": settings["model"],
+        "seed": settings["seed"],
+        "request_sha256": plan_hash,
+        "inputs_sha256": input_hash,
+        "checkpoint_sha256": settings["checkpoint"]["sha256"],
+        "prediction_sha256": file_sha256(output),
+        "expected_sha256": expected_ref.sha256,
+        "maximum_absolute_error": difference,
+        "atol": settings["atol"],
+        "rtol": settings["rtol"],
+        "environment": current_environment,
+    }
+    (workspace / "verified.json").write_text(
+        json.dumps(result, indent=2, sort_keys=True) + "\n"
+    )
+    return result
+
+
+def main() -> None:
+    """Read the fixed model check and its fresh workspace path."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("settings", type=Path)
+    parser.add_argument("workspace", type=Path)
+    args = parser.parse_args()
+    print(
+        json.dumps(
