index 00000000..d49f3674
--- /dev/null
+++ b/tools/graph_publication/prepare.py
@@ -0,0 +1,177 @@
+"""List the saved files needed for the model copies."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import shutil
+from pathlib import Path
+from typing import Any
+
+from viper._cloud import HuggingFaceRepository
+from viper._source import RunFetcher
+from viper.cloud import ViperCloud
+from viper.execution._promotion import PromotionInventory, RunGraphPromoter
+from viper.execution._promotion_worker import CopyRequest
+from viper.references import ResolvedFileRef, ResolvedRunRef
+from viper.storage import (
+    LocalArtifactStore,
+    RunPromotionPolicy,
+    TransferLimits,
+    ViperCloudDestination,
+)
+
+
+def original_bytes(payload: dict[str, Any], metadata: Path) -> bytes:
+    """Read an original local file and check its frozen size and hash."""
+    paths = [
+        Path(item["path"]) for item in payload["sources"] if item["kind"] == "vm_file"
+    ]
+    paths += [
+        metadata / "sota-metadata" / payload["sha256"],
+        metadata / "recovered-metadata" / payload["sha256"],
+    ]
+    for path in paths:
+        if path.is_file() and path.stat().st_size == payload["bytes"]:
+            raw = path.read_bytes()
+            if hashlib.sha256(raw).hexdigest() == payload["sha256"]:
+                return raw
+    raise ValueError(f"Original file is unavailable: {payload['sha256']}")
+
+
+def capture_sources(
+    workspace: Path, metadata: Path, frozen_raw: bytes, local: list[dict[str, Any]]
+) -> tuple[tuple[ResolvedFileRef, ...], int]:
+    """Save the original local source files and their location records together."""
+    local_bytes = sum(item["bytes"] for item in local) + len(frozen_raw)
+    if local_bytes > 1024**3 or local_bytes * 2 > shutil.disk_usage(workspace).free:
+        raise ValueError(
+            "Local source collection exceeds its one-GiB preparation budget"
+        )
+    files = {"source-records/original-inventory.json": frozen_raw}
+    origins = {}
+    for payload in local:
+        digest = payload["sha256"]
+        path = f"source-records/files/{digest}"
+        files[path] = original_bytes(payload, metadata)
+        origins[path] = payload["sources"]
+    files["source-records/original-locations.json"] = (
+        json.dumps(origins, sort_keys=True, indent=2) + "\n"
+    ).encode()
+    captured = LocalArtifactStore(workspace).resolved_files(files)
+    return tuple(captured), local_bytes
+
+
+def prepare(workspace: Path, metadata: Path, upstream_path: Path, output: Path) -> None:
+    """Check the full file list and save the copy request."""
+    frozen_raw = (metadata / "sota-complete.json").read_bytes()
+    frozen = json.loads(frozen_raw)
+    upstream = json.loads(upstream_path.read_bytes())
+    if upstream["errors"]:
+        raise ValueError("Upstream run discovery has unresolved records")
+    roots = tuple(
+        ResolvedRunRef.model_validate(item["run"]) for item in frozen["roots"]
+    )
+    root_keys = {item.model_dump_json() for item in roots}
+    supporting: list[ResolvedFileRef] = [
+        ResolvedRunRef.model_validate(item["root"]) for item in upstream["roots"]
+    ]
+    supporting = [
+        item for item in supporting if item.model_dump_json() not in root_keys
+    ]
+    found: dict[str, ResolvedFileRef] = {}
+    for item in upstream["files"]:
+        if item["sha256"] is not None and item["reference"]["kind"] != "git":
+            found.setdefault(
+                item["sha256"],
+                ResolvedFileRef(
+                    stored_at=item["reference"],
+                    sha256=item["sha256"],
+                    bytes=item["bytes"],
+                ),
+            )
+    aliases: dict[str, ResolvedFileRef] = {}
+    for item in frozen["aliases"]:
+        if item["reference"]["kind"] == "gcs":
+            aliases.setdefault(
+                item["sha256"],
+                ResolvedFileRef(
+                    stored_at=item["reference"],
+                    sha256=item["sha256"],
+                    bytes=item["bytes"],
+                ),
+            )
+    missing = [item for item in frozen["payloads"] if item["sha256"] not in found]
+    local = [item for item in missing if item["sha256"] not in aliases]
+    captured, local_bytes = capture_sources(workspace, metadata, frozen_raw, local)
+    supporting.extend(captured)
+    for reference in captured:
+        found.setdefault(reference.sha256, reference)
+    for payload in missing:
+        digest = payload["sha256"]
+        if digest in aliases:
+            reference = aliases[digest]
+            found[digest] = reference
+            supporting.append(reference)
+    required = {item["sha256"]: found[item["sha256"]] for item in frozen["payloads"]}
+    if any(
+        required[item["sha256"]].bytes != item["bytes"] for item in frozen["payloads"]
+    ):
+        raise ValueError("Required file size differs from the original inventory")
+    inventory = PromotionInventory(
+        roots=roots, supporting_roots=tuple(supporting), required_files=required
+    )
+    host = HuggingFaceRepository(
+        repository="pvd232/viper-plan-evidence", repo_type="dataset"
+    )
+    destination = ViperCloudDestination(owner="pvd232", workspace="rico_rebuild")
+    fetcher = RunFetcher(
+        workspace,
+        LocalArtifactStore(workspace),
+        "https://github.com/pvd232/rico-rebuild.git",
+    )
+    promoter = RunGraphPromoter(
+        workspace, ViperCloud(workspace, host), destination, fetcher=fetcher
+    )
+    order = promoter.discover_inventory(inventory)
+    request = CopyRequest(
+        repository_root=workspace,
+        inventory=inventory,
+        policy=RunPromotionPolicy(hosts=(host,)),
+        destination=destination,
+        limits=TransferLimits(
+            staging_bytes=128 * 1024**3, cache_bytes=96 * 1024**3, connections=4
+        ),
+    )
+    output.write_text(request.model_dump_json(indent=2) + "\n")
+    coverage = dict(
+        original_inventory_sha256=hashlib.sha256(frozen_raw).hexdigest(),
+        required_files=len(required),
+        required_bytes=sum(item["bytes"] for item in frozen["payloads"]),
+        model_roots=len(roots),
+        supporting_roots=len(supporting),
+        snapshots=len(order),
+        discovered_files=len(promoter.source_files),
+        local_source_bytes=local_bytes,
+        source_settings_changed=False,
+    )
+    output.with_suffix(".coverage.json").write_text(
+        json.dumps(coverage, sort_keys=True, indent=2) + "\n"
+    )
+    print(json.dumps(coverage, sort_keys=True), flush=True)
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("workspace", type=Path)
+    parser.add_argument("metadata", type=Path)
+    parser.add_argument("upstream", type=Path)
+    parser.add_argument("output", type=Path)
+    arguments = parser.parse_args()
+    prepare(
+        arguments.workspace.resolve(),
+        arguments.metadata.resolve(),
+        arguments.upstream,
+        arguments.output,
+    )
