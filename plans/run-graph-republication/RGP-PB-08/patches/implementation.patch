+"""Prepare fixed recovery checks and register their completed results."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+from viper.execution._promotion_journal import SnapshotCopy
+from viper.execution._promotion_worker import CopyRequest
+from viper.execution._publication import write_synchronized
+from viper.references import ResolvedFileRef, resolve_snapshot_file_ref
+from viper.serialization import document_digest
+
+from rico.domain.mil.serialization import file_sha256
+
+SELECTED_MODELS = (
+    "mil-123464",
+    "hopfield-123457",
+    "hopfield-123458",
+    "hopfield-123459",
+)
+
+
+def saved_environment(runtime: dict[str, Any]) -> dict[str, Any]:
+    """Read numerical versions from the two frozen runtime record formats."""
+    if "candidate_execution_context" in runtime:
+        context = runtime["candidate_execution_context"]
+        numerical = context["numerical_runtime"]
+        backend = context["backend"]
+        return {
+            "python": numerical["python_version"],
+            "torch": numerical["pytorch_version"],
+            "numpy": numerical["numpy_version"],
+            "cuda": backend["pytorch_cuda_version"],
+            "device": backend["gpu_devices"][0]["model"],
+        }
+    return {
+        "python": runtime["python"].split()[0],
+        "torch": runtime["torch"],
+        "cuda": runtime["cuda"],
+        "device": runtime["gpu"],
+        "numpy": next(
+            value.split("==", 1)[1]
+            for value in runtime["packages"]
+            if value.startswith("numpy==")
+        ),
+    }
+
+
+def _save_model_check(
+    path: Path,
+    settings: dict[str, Any],
+    locations: dict[str, list[dict[str, Any]]],
+) -> None:
+    """Keep an existing request's exact bytes when its addresses remain valid."""
+    if not path.exists():
+        write_synchronized(
+            path, (json.dumps(settings, indent=2, sort_keys=True) + "\n").encode()
+        )
+        return
+    saved = json.loads(path.read_bytes())
+    for section in ("checkpoint", "expected", "files"):
+        expected = (
+            settings[section] if section == "files" else {section: settings[section]}
+        )
+        previous = saved[section] if section == "files" else {section: saved[section]}
+        if expected.keys() != previous.keys():
+            raise ValueError(f"Recovery file roles changed: {path}")
+        for key, reference in expected.items():
+            if (
+                previous[key] not in locations[reference["sha256"]]
+                or previous[key]["bytes"] != reference["bytes"]
+            ):
+                raise ValueError(
+                    f"Recovery file changed or its address is missing: {path}"
+                )
+        settings[section] = saved[section]
+    if settings != saved:
+        raise ValueError(f"Recovery settings changed: {path}")
+
+
+def model_checks(root: Path, progress: Path, result: Path, output: Path) -> list[Path]:
+    """Prepare model checks from completed copies, preserving valid saved requests."""
+    publication: dict[str, Any] = json.loads(result.read_bytes())["publications"][0]
+    saved: dict[str, Any] = json.loads(progress.read_bytes())
+    if (
+        not publication["passed"]
+        or publication["mapping_sha256"]
+        != hashlib.sha256(
+            json.dumps(
+                saved, ensure_ascii=False, separators=(",", ":"), sort_keys=True
+            ).encode()
+        ).hexdigest()
+    ):
+        raise ValueError("The copy result and progress file differ")
+    locations: dict[str, list[dict[str, Any]]] = {}
+    for value in saved["copies"].values():
+        copy = SnapshotCopy.model_validate(value)
+        if copy.published is None:
+            raise ValueError("A copied snapshot is still pending")
+        for member in copy.expected.files:
+            locations.setdefault(member.sha256, []).append(
+                resolve_snapshot_file_ref(copy.published, member).model_dump(
+                    mode="json"
+                ),
+            )
+    selected_roots = {item["sha256"] for item in publication["source_roots"]}
+    paths = []
+    for model, name in (("mil", "direct_mil"), ("hopfield", "asymmetric_hopfield")):
+        pointer = root / "models" / f"{name}.json"
+        record = json.loads(pointer.read_bytes())
+        entries = record.get("seeds", [record])
+        inputs = json.loads((root / record["model_inputs"]).read_bytes())["files"]
+        runtime = json.loads((root / record["runtime"]).read_bytes())
+        required = (
+            ("response_data", "manifest")
+            if model == "mil"
+            else ("fit_data", "queries", "keys")
+        )
+        for item in entries:
+            if item["native_benchmark"]["cloud_run"]["sha256"] not in selected_roots:
+                continue
+            settings = {
+                "model": model,
+                "seed": item["canonical_seed"],
+                "host": publication["host"],
+                "source_pointer_sha256": file_sha256(pointer),
+                "source_commit": record["source_commit"],
+                "source_run": item["native_benchmark"]["cloud_run"],
+                "environment": saved_environment(runtime),
+                "checkpoint": locations[item["selected_checkpoint"]["sha256"]][0],
+                "files": {key: locations[inputs[key]["sha256"]][0] for key in required},
+                "expected": locations[item["tune_predictions"]["sha256"]][0],
+                "split": "tune",
+                "atol": 0.0,
+                "rtol": 0.0,
+            }
+            path = output / f"{model}-{item['canonical_seed']}.json"
+            _save_model_check(path, settings, locations)
+            paths.append(path)
+    return paths
+
+
+def recovery_reports(checks: Path) -> list[dict[str, Any]]:
+    """Check each model's saved recovery output against its fixed request."""
+    evidence = []
+    for name in SELECTED_MODELS:
+        settings_path = checks / f"{name}.json"
+        settings = json.loads(settings_path.read_bytes())
+        directory = checks / name
+        report = json.loads((directory / "verified.json").read_bytes())
+        if not report["passed"] or report["request_sha256"] != file_sha256(
+            settings_path
+        ):
+            raise ValueError(f"Recovery evidence differs for {name}")
+        if report["prediction_sha256"] != file_sha256(directory / "prediction.npz"):
+            raise ValueError(f"The saved prediction changed for {name}")
+        checkpoint = ResolvedFileRef.model_validate(settings["checkpoint"])
+        if report["checkpoint_sha256"] != checkpoint.sha256:
+            raise ValueError(f"The recovered weights differ for {name}")
+        expected = {
+            "model": settings["model"],
+            "seed": settings["seed"],
+            "expected_sha256": settings["expected"]["sha256"],
+            "atol": settings["atol"],
+            "rtol": settings["rtol"],
+            "environment": settings["environment"],
+        }
+        if name != f"{settings['model']}-{settings['seed']}" or any(
+            report[key] != value for key, value in expected.items()
+        ):
+            raise ValueError(
+                f"The recovery result belongs to another model check: {name}"
+            )
+        evidence.append(report)
+    return evidence
+
+
+def register(
+    request_path: Path,
+    result_path: Path,
+    checks: Path,
+    output: Path,
+    model_root: Path | None = None,
+) -> dict[str, Any]:
+    """Register all four recovered models after checking their saved evidence."""
+    request = CopyRequest.model_validate_json(request_path.read_bytes())
+    pointer_root = request.repository_root if model_root is None else model_root
+    result: dict[str, Any] = json.loads(result_path.read_bytes())
+    if result["operation_sha256"] != document_digest(request):
+        raise ValueError("The result belongs to another publication request")
+    if (
+        len(request.inventory.roots) != len(SELECTED_MODELS)
+        or len(request.policy.hosts) != 1
+        or len(result["publications"]) != 1
+    ):
+        raise ValueError("Registration requires four selected models and one host")
+    host = request.policy.hosts[0]
+    publication = result["publications"][0]
+    if not publication["passed"] or publication["host"] != host.model_dump(mode="json"):
+        raise ValueError("A publication failed its graph comparison")
+    if publication["required_files_checked"] != len(request.inventory.required_files):
+        raise ValueError("A required file is missing")
+    if publication["source_roots"] != [
+        ref.model_dump(mode="json") for ref in request.inventory.roots
+    ]:
+        raise ValueError("The selected model roots changed")
+    selected_roots = set()
+    for name in SELECTED_MODELS:
+        settings_path = checks / f"{name}.json"
+        settings = json.loads(settings_path.read_bytes())
+        selected_roots.add(settings["source_run"]["sha256"])
+        pointer_name = (
+            "direct_mil" if settings["model"] == "mil" else "asymmetric_hopfield"
+        )
+        pointer = pointer_root / "models" / f"{pointer_name}.json"
+        if file_sha256(pointer) != settings["source_pointer_sha256"]:
+            raise ValueError("The original model pointer changed during recovery")
+    if selected_roots != {root.sha256 for root in request.inventory.roots}:
+        raise ValueError("Recovery checks must cover every selected model root")
+    evidence = recovery_reports(checks)
+    accepted = {"schema_version": 1, "publication": result, "recovery": evidence}
+    write_synchronized(
+        output, (json.dumps(accepted, indent=2, sort_keys=True) + "\n").encode()
+    )
+    return accepted
+
+
+def main() -> None:
+    """Prepare model checks or register the completed publication."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    tasks = parser.add_subparsers(dest="action", required=True)
+    prepare = tasks.add_parser("prepare")
+    for name in ("root", "progress", "result", "output"):
+        prepare.add_argument(name, type=Path)
+    finish = tasks.add_parser("register")
+    for name in ("request", "result", "checks", "output"):
+        finish.add_argument(name, type=Path)
+    finish.add_argument("--model-root", type=Path)
+    args = parser.parse_args()
+    if args.action == "prepare":
+        print(
+            json.dumps(
+                [
+                    str(path)
+                    for path in model_checks(
+                        args.root, args.progress, args.result, args.output
+                    )
+                ]
+            )
+        )
+    else:
+        register(args.request, args.result, args.checks, args.output, args.model_root)
+        print(args.output)
+
+
+if __name__ == "__main__":
+    main()
