+    )
+    verified = verify_run_result(
+        record,
+        policy=VerificationPolicy(trusted_source_repositories=frozenset({REPOSITORY})),
+        fetcher=RunFetcher(case.root, LocalArtifactStore(case.root), REPOSITORY),
+    )
+    assert verified is not None
