+    """Reject oversized work and remove only the copy's verified downloads."""
+    limits = TransferLimits(staging_bytes=64, cache_bytes=32, connections=2)
+    space = TransferSpace(tmp_path / "copy", limits)
+    fetcher = RunFetcher(
