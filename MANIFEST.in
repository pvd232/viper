prune src/viper_provenance.egg-info
prune docs/development
prune docs/internal
include llms.txt
include AGENTS.md
include CHANGELOG.md
include CONTRIBUTING.md
include Makefile
include MANIFEST.in
recursive-include .github/workflows *.yml
include docs/README.md
recursive-include docs/explanation *.md
recursive-include docs/how-to *.md
recursive-include docs/reference *.md
recursive-include docs/releases *.md *.json
recursive-include docs/tutorials *.md
recursive-include examples *.md *.py *.csv
recursive-include tests *.md *.py *.yaml *.json
